# ==========================================
# N100 Financial Intelligence Platform
# .gitignore
# ==========================================

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Pytest cache
.pytest_cache/

# Python virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.local
.env.*

# IDE files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log
output/logs/

# Temporary files
*.tmp
*.temp

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python build files
build/
dist/
*.egg-info/

# Coverage files
.coverage
htmlcov/

# Backup files
*.bak